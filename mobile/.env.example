# Use the exact same Supabase project as the web portal.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Required for Expo remote push token registration on a native development/production build.
# Local scheduled meeting reminders can still be tested before this is configured.
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
